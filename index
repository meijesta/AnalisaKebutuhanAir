<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisa Kebutuhan Air - PDAM Surya Sembada</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #005bc5;
            --primary-hover: #004494;
            --secondary: #eef5fc;
            --text-dark: #2d3748;
            --text-light: #718096;
            --border: #e2e8f0;
            --success: #10b981;
            --warning: #f59e0b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0; padding: 20px;
            background: linear-gradient(135deg, #f6f9fc 0%, #eef2f7 100%);
            color: var(--text-dark); min-height: 100vh;
        }

        .container { max-width: 900px; margin: 0 auto; }
        
        .card-panel {
            background: #ffffff; padding: 30px; border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 91, 197, 0.08); margin-bottom: 20px;
        }
        .card-panel h2 { 
            margin-top: 0; color: var(--primary); font-weight: 700; 
            border-bottom: 2px solid var(--secondary); padding-bottom: 12px; margin-bottom: 20px;
            display: flex; align-items: center; gap: 10px;
        }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 15px; }
        .grid-dynamic { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 15px; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px dashed var(--border);}
        
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; color: var(--text-light); text-transform: uppercase;}
        
        select, input[type="text"], input[type="number"] {
            width: 100%; padding: 12px 15px; border: 2px solid var(--border); border-radius: 8px; 
            box-sizing: border-box; font-family: inherit; font-size: 15px; background-color: #fff;
            transition: all 0.2s ease;
        }
        select:focus, input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0, 91, 197, 0.1); }

        .btn-group { display: flex; gap: 10px; margin-top: 25px; flex-wrap: wrap;}
        button {
            flex: 1; min-width: 150px; padding: 12px; border: none; border-radius: 8px;
            font-size: 14px; font-weight: 700; font-family: inherit;
            cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-calc { background-color: var(--primary); color: white; }
        .btn-calc:hover { background-color: var(--primary-hover); }
        .btn-save { background-color: var(--warning); color: #fff; display: none; }
        .btn-save:hover { background-color: #d97706; }
        .btn-print { background-color: var(--success); color: white; display: none; }
        .btn-print:hover { background-color: #059669; }

        .history-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 15px;}
        .history-table th, .history-table td { padding: 10px; text-align: left; border-bottom: 1px solid var(--border); }
        .history-table th { background-color: var(--secondary); color: var(--primary); }
        .btn-del { background: #ef4444; color: white; padding: 5px 10px; border-radius: 4px; font-size: 11px; cursor: pointer; border: none;}

        .print-section { background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: none; margin-bottom: 30px;}
        .header-table { width: 100%; border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 20px; }
        .header-table td { vertical-align: middle; }
        .title-center { text-align: center; font-weight: bold; font-size: 18px; line-height: 1.4; }
        .no-reg { text-align: right; font-weight: bold; font-size: 16px; color: #444; }
        
        .calc-section { font-size: 13px; margin-bottom: 25px; line-height: 1.6; }
        .calc-row { display: flex; margin-bottom: 4px; }
        .calc-label { width: 340px; }
        .calc-equals { width: 30px; text-align: center; }
        .calc-value { font-weight: 700; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 8px; font-size: 14px; color: var(--primary); text-transform: uppercase; border-bottom: 1px dashed #ccc; padding-bottom: 5px;}
        
        .meter-table { width: 100%; border-collapse: collapse; margin-bottom: 40px; font-size: 11px; }
        .meter-table th, .meter-table td { border: 1px solid #666; padding: 6px; text-align: center; }
        .meter-table th { background-color: #f8fafc; font-weight: bold; }
        .highlight-row { background-color: var(--primary) !important; color: #fff !important; font-weight: bold; transform: scale(1.01); }

        .signature-block { display: flex; justify-content: space-between; text-align: center; margin-top: 40px; font-size: 12px; }
        .sig-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end;}
        .sig-title { margin-bottom: 60px; font-weight: bold; text-transform: uppercase; color: #555;}
        .sig-name { font-weight: bold; text-decoration: underline; font-size: 13px;}

        @media print {
            body { background: #fff; padding: 0; font-family: 'Arial', sans-serif; }
            .no-print { display: none !important; }
            .print-section { display: block; box-shadow: none; padding: 0; width: 100%; }
            .section-title { color: #000; border-bottom: 1px solid #000; }
            .highlight-row { background-color: #e2e8f0 !important; color: #000 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            @page { size: A4; margin: 1.5cm; }
        }
    </style>
</head>
<body onload="initApp()">

<div class="container">
    <!-- FORM INPUT -->
    <div class="card-panel no-print">
        <h2>
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            Form Analisa Kebutuhan Air
        </h2>
        <div class="grid-2">
            <div class="form-group">
                <label>Nomor Pendaftaran</label>
                <input type="text" id="noDaftar" placeholder="Contoh: T2026 000 3021">
            </div>
            <div class="form-group">
                <label>Nama Pemohon / Instansi</label>
                <input type="text" id="namaInstansi" placeholder="Contoh: SMA KRISTEN PETRA 2">
            </div>
            <div class="form-group">
                <label>Alamat Pemasangan</label>
                <input type="text" id="alamat" placeholder="Contoh: Jl. Raya Manyar Tirtoasri">
            </div>
            <div class="form-group">
                <label>Kategori Bangunan (Standar SNI/Morimura)</label>
                <select id="kategoriBangunan" onchange="renderDynamicInputs()">
                    <option value="sekolah">Sekolah / Kampus</option>
                    <option value="hotel">Hotel / Penginapan</option>
                    <option value="apartemen">Apartemen / Flat</option>
                    <option value="rumahsakit">Rumah Sakit / Klinik Inap</option>
                    <option value="kos">Asrama / Rumah Kos</option>
                    <option value="kantor">Kantor / Instansi</option>
                    <option value="komersial">Ruko / Komersial Umum</option>
                    <option value="custom" style="font-weight:bold; background:#eef5fc;">🔧 Lainnya (Input Volume Langsung)</option>
                </select>
            </div>
        </div>

        <div id="dynamicInputs" class="grid-dynamic"></div>

        <div class="form-group" style="margin-top: 15px; max-width: 300px;">
            <label>Jam Operasional/Pemakaian (Jam)</label>
            <input type="number" id="jamOperasional" value="15" min="1" max="24" step="1">
        </div>

        <div class="btn-group">
            <button class="btn-calc" onclick="kalkulasi()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                Proses Analisa
            </button>
            <button class="btn-save" id="btnSave" onclick="simpanData()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                Simpan Hasil
            </button>
            <button class="btn-print" id="btnPrint" onclick="window.print()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Cetak Dokumen
            </button>
        </div>
    </div>

    <!-- AREA LAPORAN (PRINT) -->
    <div class="print-section" id="laporanArea">
        <table class="header-table">
            <tr>
                <td width="15%">
                    <div style="width:60px; height:60px; border:2px solid #005bc5; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:bold; color:#005bc5;">PDAM</div>
                </td>
                <td width="60%" class="title-center">
                    ANALISA KEBUTUHAN AIR<br>
                    <span id="outNama" style="color:var(--primary);"></span><br>
                    <span id="outAlamat" style="font-weight:normal; font-size:13px;"></span>
                </td>
                <td width="25%" class="no-reg">Reg: <span id="outNoDaftar"></span></td>
            </tr>
        </table>

        <div class="calc-section" id="detailKalkulasi"></div>

        <div class="calc-section">
            <div class="section-title">TOTAL KEBUTUHAN AIR</div>
            <div class="calc-row"><div class="calc-label">Kebutuhan air total</div><div class="calc-equals">=</div><div class="calc-value"><span id="outTotalJam">0.00</span> m&sup3;/jam</div></div>
            <div class="calc-row"><div class="calc-label">Safety factor (kebocoran & non-domestik) 30% maka, Q</div><div class="calc-equals">=</div><div class="calc-value"><span id="outSafety">0.00</span> m&sup3;/jam</div></div>
            <div class="calc-row"><div class="calc-label" style="font-style: italic; color:#666;">Sistem pelayanan air bersih menggunakan tandon, sehingga faktor jam puncak diabaikan</div></div>
            <div class="calc-row"><div class="calc-label">Maka Q peak = Q</div><div class="calc-equals">=</div><div class="calc-value" style="font-size:15px; color:var(--primary);"><span id="outQPeak">0.00</span> m&sup3;/jam</div></div>
        </div>

        <table class="meter-table">
            <thead>
                <tr>
                    <th rowspan="2">Ukuran Meter</th>
                    <th>Starting Flow</th><th>Qminimal</th><th>Q3</th><th colspan="2">Q nominal /Qpeak</th><th colspan="2">Q3 Maksimal</th>
                    <th rowspan="2">Min Charge<br>(m&sup3;/bln)</th>
                </tr>
                <tr>
                    <th>Qstart</th><th>Q1</th><th>(m&sup3;/jam)</th><th>Q3 Min</th><th>(m&sup3;/bln)</th><th>(m&sup3;/jam)</th><th>(m&sup3;/bln)</th>
                </tr>
            </thead>
            <tbody id="meterBody">
                <tr id="row-15"><td>&frac12;" / 15 mm</td><td>0.011</td><td>0.03</td><td>1.5</td><td>0.04</td><td>13</td><td>1</td><td>432</td><td>10</td></tr>
                <tr id="row-25"><td>1" / 25 mm</td><td>0.025</td><td>0.07</td><td>4</td><td>1</td><td>432</td><td>3</td><td>1008</td><td>30</td></tr>
                <tr id="row-40"><td>1&frac12;" / 40 mm</td><td>0.07</td><td>0.2</td><td>10</td><td>2.80</td><td>1,008</td><td>8</td><td>2,880</td><td>70</td></tr>
                <tr id="row-50"><td>2" / 50 mm</td><td>0.09</td><td>0.3</td><td>15</td><td>8.00</td><td>2,880</td><td>12</td><td>4,320</td><td>110</td></tr>
                <tr id="row-80"><td>3" / 80 mm</td><td>0.3</td><td>0.8</td><td>40</td><td>12.00</td><td>4,320</td><td>32</td><td>11,520</td><td>290</td></tr>
                <tr id="row-100"><td>4" / 100 mm</td><td>0.38</td><td>1.2</td><td>60</td><td>32.00</td><td>11,520</td><td>48</td><td>17,280</td><td>430</td></tr>
                <tr id="row-150"><td>6" / 150 mm</td><td>1</td><td>3</td><td>150</td><td>48.00</td><td>17,280</td><td>120</td><td>43,200</td><td>1,080</td></tr>
                <tr id="row-200"><td>8" / 200 mm</td><td>1.6</td><td>5</td><td>250</td><td>120.00</td><td>43,200</td><td>200</td><td>72,000</td><td>1,800</td></tr>
            </tbody>
        </table>

        <div class="signature-block">
            <div class="sig-item"><div class="sig-title">Petugas Survey</div><div class="sig-name">Danny Erwanto</div><div>NIP. 1.17.01733</div></div>
            <div class="sig-item"><div class="sig-title">Dibuat Oleh</div><div class="sig-name">Hajar Pakerti S. W.</div><div>NIP. 1.17.01766</div></div>
            <div class="sig-item"><div class="sig-title">Supervisor</div><div class="sig-name">Agus Martono</div><div>NIP. 1.06.01397</div></div>
            <div class="sig-item"><div class="sig-title">Manajer PTT</div><div class="sig-name">Adi Nugroho</div><div>NIP. 1.98.01248</div></div>
        </div>
    </div>

    <!-- RIWAYAT TERSIMPAN -->
    <div class="card-panel no-print" id="historyPanel">
        <h2>
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
            Riwayat Perhitungan
        </h2>
        <table class="history-table">
            <thead>
                <tr>
                    <th>Tanggal</th>
                    <th>No Reg</th>
                    <th>Nama Instansi</th>
                    <th>Qpeak (m&sup3;/jam)</th>
                    <th>Meter Air</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody id="historyBody"></tbody>
        </table>
    </div>
</div>

<script>
    const standarAir = {
        'sekolah': [
            { id: 'siswa', label: 'Siswa / Mahasiswa', std: 50, unit: 'Orang' },
            { id: 'guru', label: 'Guru / Karyawan', std: 50, unit: 'Orang' },
            { id: 'tamu', label: 'Tamu / Pengunjung', std: 10, unit: 'Orang' }
        ],
        'hotel': [
            { id: 'kamar', label: 'Tamu (Per Kamar)', std: 250, unit: 'Kamar' },
            { id: 'karyawan', label: 'Karyawan Hotel', std: 150, unit: 'Orang' }
        ],
        'apartemen': [
            { id: 'penghuni', label: 'Penghuni Apartemen', std: 250, unit: 'Orang' },
            { id: 'pengelola', label: 'Pengelola / Staff', std: 100, unit: 'Orang' }
        ],
        'rumahsakit': [
            { id: 'pasien', label: 'Pasien (Per Bed)', std: 500, unit: 'Bed' },
            { id: 'medis', label: 'Pegawai / Medis', std: 120, unit: 'Orang' },
            { id: 'pengunjung', label: 'Pengunjung Pasien', std: 10, unit: 'Orang' }
        ],
        'kos': [
            { id: 'penghuni', label: 'Penghuni Kos/Asrama', std: 120, unit: 'Orang' },
            { id: 'pengelola', label: 'Pengelola/Penjaga', std: 50, unit: 'Orang' }
        ],
        'kantor': [
            { id: 'pegawai', label: 'Pegawai Kantor', std: 50, unit: 'Orang' },
            { id: 'tamu', label: 'Tamu / Klien', std: 10, unit: 'Orang' }
        ],
        'komersial': [
            { id: 'penghuni', label: 'Penghuni / Pegawai', std: 100, unit: 'Orang' },
            { id: 'pengunjung', label: 'Pengunjung Ruko', std: 10, unit: 'Orang' }
        ]
    };

    let activeCategory = [];

    function initApp() {
        renderDynamicInputs();
        muatRiwayat();
    }

    function renderDynamicInputs() {
        const catKey = document.getElementById('kategoriBangunan').value;
        const container = document.getElementById('dynamicInputs');
        container.innerHTML = '';

        if (catKey === 'custom') {
            activeCategory = 'custom';
            container.innerHTML = `
            <div class="form-group" style="margin-bottom:0;">
                <label>Keterangan Kebutuhan <br><small style="color:#888; font-size:11px; font-weight:normal;">Contoh: Asrama Khusus</small></label>
                <input type="text" id="input_custom_nama" placeholder="Contoh: Utilitas Pabrik">
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label>Total Kebutuhan Harian <br><small style="color:#888; font-size:11px; font-weight:normal;">Satuan: M&sup3;/hari (Meter Kubik per Hari)</small></label>
                <input type="text" inputmode="decimal" id="input_custom_vol" placeholder="Contoh: 50 (Bisa pakai titik/koma)">
            </div>`;
        } else {
            activeCategory = standarAir[catKey];
            activeCategory.forEach(item => {
                container.innerHTML += `
                <div class="form-group" style="margin-bottom:0;">
                    <label>Jml ${item.label} <br><small style="color:#888; font-size:11px; font-weight:normal;">St: ${item.std} L/hari | Sat: ${item.unit}</small></label>
                    <input type="number" id="input_${item.id}" placeholder="0" min="0">
                </div>`;
            });
        }
    }

    function buatBlokHitung(huruf, judul, jumlah, standar, jam) {
        if (jumlah <= 0) return '';
        let volHariL = jumlah * standar;
        let volHariM3 = volHariL / 1000;
        let volJamM3 = volHariM3 / jam;

        return `
        <div class="section-title">${huruf}. KEBUTUHAN AIR (${judul.toUpperCase()})</div>
        <div class="calc-row"><div class="calc-label">Jumlah Satuan</div><div class="calc-equals">=</div><div class="calc-value">${jumlah}</div></div>
        <div class="calc-row"><div class="calc-label">Estimasi kebutuhan air / satuan</div><div class="calc-equals">=</div><div class="calc-value">${standar} L/hari (SNI/Morimura)</div></div>
        <div class="calc-row"><div class="calc-label">Kebutuhan air perhari (Liter)</div><div class="calc-equals">=</div><div class="calc-value">${volHariL.toLocaleString('id-ID')} L/hari</div></div>
        <div class="calc-row"><div class="calc-label">Kebutuhan air perhari (M&sup3;)</div><div class="calc-equals">=</div><div class="calc-value">${volHariM3.toFixed(2)} m&sup3;/hari</div></div>
        <div class="calc-row"><div class="calc-label">Lama pemakaian air ${jam} jam, maka</div><div class="calc-equals">=</div><div class="calc-value">${volJamM3.toFixed(3)} m&sup3;/jam</div></div>
        `;
    }

    function kalkulasi() {
        const noDaftar = document.getElementById('noDaftar').value || '-';
        const namaInstansi = document.getElementById('namaInstansi').value || 'NAMA PEMOHON';
        document.getElementById('outNoDaftar').innerText = noDaftar;
        document.getElementById('outNama').innerText = namaInstansi;
        document.getElementById('outAlamat').innerText = document.getElementById('alamat').value || '-';
        
        const jam = parseFloat(document.getElementById('jamOperasional').value) || 15;
        let detailHTML = '';
        let totalM3Jam = 0;
        let urut = 65; 

        if (activeCategory === 'custom') {
            const namaKebutuhan = document.getElementById('input_custom_nama').value || 'Kebutuhan Global';
            
            // Baca input, ubah koma menjadi titik agar bisa dihitung matematis
            let rawVol = document.getElementById('input_custom_vol').value || "0";
            rawVol = rawVol.replace(',', '.');
            const volM3Hari = parseFloat(rawVol) || 0;
            
            if (volM3Hari <= 0) {
                alert("Silakan masukkan Total Kebutuhan Harian (M³) dengan benar!");
                return;
            }

            const volLiter = volM3Hari * 1000;
            const volJamM3 = volM3Hari / jam;
            totalM3Jam = volJamM3;

            detailHTML = `
            <div class="section-title">A. KEBUTUHAN AIR (${namaKebutuhan.toUpperCase()})</div>
            <div class="calc-row"><div class="calc-label">Sumber Data</div><div class="calc-equals">=</div><div class="calc-value">Input Volume Langsung (Custom)</div></div>
            <div class="calc-row"><div class="calc-label">Kebutuhan air perhari (Liter)</div><div class="calc-equals">=</div><div class="calc-value">${volLiter.toLocaleString('id-ID')} l/hari</div></div>
            <div class="calc-row"><div class="calc-label">Kebutuhan air perhari (M&sup3;)</div><div class="calc-equals">=</div><div class="calc-value">${volM3Hari.toFixed(2)} m&sup3;/hari</div></div>
            <div class="calc-row"><div class="calc-label">Lama pemakaian air ${jam} jam, maka</div><div class="calc-equals">=</div><div class="calc-value">${volJamM3.toFixed(3)} m&sup3;/jam</div></div>
            `;
        } else {
            activeCategory.forEach(item => {
                const rawJml = document.getElementById(`input_${item.id}`).value || "0";
                const jml = parseInt(rawJml) || 0;
                if (jml > 0) {
                    detailHTML += buatBlokHitung(String.fromCharCode(urut++), item.label, jml, item.std, jam);
                    totalM3Jam += ((jml * item.std) / 1000) / jam;
                }
            });

            if(totalM3Jam === 0) {
                alert("Silakan isi minimal satu entitas (Siswa, Pegawai, dll) agar bisa dihitung!");
                return;
            }
        }

        document.getElementById('detailKalkulasi').innerHTML = detailHTML;

        const qSafety = totalM3Jam * 1.30; 
        document.getElementById('outTotalJam').innerText = totalM3Jam.toFixed(3);
        document.getElementById('outSafety').innerText = qSafety.toFixed(3);
        document.getElementById('outQPeak').innerText = qSafety.toFixed(3);

        document.querySelectorAll('#meterBody tr').forEach(tr => tr.classList.remove('highlight-row'));
        let idRow = 'row-15';
        if (qSafety <= 1.5) idRow = 'row-15';
        else if (qSafety <= 4) idRow = 'row-25';
        else if (qSafety <= 10) idRow = 'row-40';
        else if (qSafety <= 15) idRow = 'row-50';
        else if (qSafety <= 40) idRow = 'row-80';
        else if (qSafety <= 60) idRow = 'row-100';
        else if (qSafety <= 150) idRow = 'row-150';
        else idRow = 'row-200';

        document.getElementById(idRow).classList.add('highlight-row');

        document.getElementById('laporanArea').style.display = 'block';
        document.getElementById('btnPrint').style.display = 'flex';
        document.getElementById('btnSave').style.display = 'flex';
        document.getElementById('laporanArea').scrollIntoView({ behavior: 'smooth' });
    }

    function simpanData() {
        const trMeter = document.querySelector('.highlight-row td:first-child');
        const dataBaru = {
            id: Date.now(),
            tanggal: new Date().toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year: 'numeric', hour:'2-digit', minute:'2-digit'}),
            noDaftar: document.getElementById('noDaftar').value || 'Tanpa No Reg',
            nama: document.getElementById('namaInstansi').value || 'Tanpa Nama',
            qpeak: document.getElementById('outQPeak').innerText,
            meter: trMeter ? trMeter.innerHTML : '-'
        };

        let riwayat = JSON.parse(localStorage.getItem('riwayatPDAM') || '[]');
        riwayat.unshift(dataBaru); 
        localStorage.setItem('riwayatPDAM', JSON.stringify(riwayat));
        
        muatRiwayat();
        alert('Data berhasil disimpan secara lokal di browser Anda!');
    }

    function muatRiwayat() {
        const riwayat = JSON.parse(localStorage.getItem('riwayatPDAM') || '[]');
        const tbody = document.getElementById('historyBody');
        tbody.innerHTML = '';

        if(riwayat.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:#888;">Belum ada data yang tersimpan</td></tr>`;
            return;
        }

        riwayat.forEach(data => {
            tbody.innerHTML += `
                <tr>
                    <td>${data.tanggal}</td>
                    <td style="font-weight:bold;">${data.noDaftar}</td>
                    <td>${data.nama}</td>
                    <td style="color:var(--primary); font-weight:bold;">${data.qpeak}</td>
                    <td>${data.meter}</td>
                    <td><button class="btn-del" onclick="hapusData(${data.id})">Hapus</button></td>
                </tr>
            `;
        });
    }

    function hapusData(id) {
        if(confirm("Yakin ingin menghapus data ini dari riwayat?")) {
            let riwayat = JSON.parse(localStorage.getItem('riwayatPDAM') || '[]');
            riwayat = riwayat.filter(item => item.id !== id);
            localStorage.setItem('riwayatPDAM', JSON.stringify(riwayat));
            muatRiwayat();
        }
    }
</script>

